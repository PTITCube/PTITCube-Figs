                    </mxGeometry>
                </mxCell>                <mxCell id="e3" value="Chạy tốt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#14532D;" parent="1" source="st_run" target="st_feed" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        
