                </mxCell>                <mxCell id="m2" value="2. Đòi Mutex (Bị Chặn Blocked!)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333EA;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#581C87;" parent="1" edge="1">
