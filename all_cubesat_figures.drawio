  <diagram id="lab6_surface_treatment" name="2. Surface Treatment &amp; Anodizing">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1010" pageHeight="230" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="st_title" value="&lt;div style=&quot;font-size:15px;font-weight:bold;color:#0F172A;&quot;&gt;QUY TRÌNH XỬ LÝ BỀ MẶT: ANODIZE TYPE III VS ALODINE 5541&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="15" width="920" height="30" as="geometry"/>
                </mxCell>                <mxCell id="raw" value="Phôi Nhôm CNC&lt;br&gt;&lt;b&gt;Al 6061-T6&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#334155;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="50" y="100" width="170" height="60" as="geometry"/>
                </mxCell>                <mxCell id="mask" value="Dán Băng Che&lt;br&gt;&lt;b&gt;(Selective Masking)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="280" y="100" width="190" height="60" as="geometry"/>
                </mxCell>                <mxCell id="b_ano" value="&lt;div style=&quot;font-weight:bold;color:#991B1B;&quot;&gt;4 Thanh Ray Ngoài: Anode Cứng Type III&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;Oxit nhôm dày 25-50 μm &amp;bull; Độ cứng 60-70 HRC &amp;bull; &lt;b&gt;Cách điện (Chống hàn nguội)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;fontColor=#991B1B;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
