  <diagram id="lab3_watchdog_fsm" name="3. Watchdog Timer FSM">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="350" background="#ffffff" math="0" shadow="0">
