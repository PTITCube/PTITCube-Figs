        <mxCell id="lbl_sample_bar" value="Điểm lấy mẫu vi mạch thu (Rx Sampling Points: 50% T_bit chính giữa chu kỳ bit theo xung Clock nhân bội 16×)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="320" y="560" width="1920" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="leg_badge_0" value="START" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#E11D48;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="140" y="645" width="220" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="leg_text_0" value="Start bit, always low (Mức 0 cố định - 0V). Sườn xuống đánh thức và đồng bộ bộ thu Rx." style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=24;fontColor=#1E293B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="380" y="645" width="2020" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="leg_badge_1" value="D0 – D7 (n)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0284C7;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="140" y="710" width="220" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="leg_text_1" value="Data bits payload (8 bit dữ liệu). Thể hiện cả 2 mức 0 và 1, truyền LSB (D0) trước, MSB (D7) sau." style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=24;fontColor=#1E293B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="380" y="710" width="2020" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="leg_badge_2" value="[P]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0284C7;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="140" y="775" width="220" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="leg_text_2" value="Parity bit (Bit chẵn/lẻ tùy chọn). Có thể là mức 0 hoặc 1 (chuẩn 8-N-1 không sử dụng bit này)." style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=24;fontColor=#1E293B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="380" y="775" width="2020" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="leg_badge_3" value="STOP" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#16A34A;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="140" y="840" width="220" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="leg_text_3" value="Stop bit, always high (Mức 1 cố định - 3.3V). Khôi phục đường truyền về mức tích cực trước khi kết thúc." style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=24;fontColor=#1E293B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="380" y="840" width="2020" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="leg_badge_4" value="IDLE" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#64748B;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="140" y="905" width="220" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="leg_text_4" value="Đường truyền rảnh khi không có truyền nhận dữ liệu. Luôn duy trì ở mức cao 3.3V (Mark)." style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=24;fontColor=#1E293B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="380" y="905" width="2020" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="footer_spec" value="Cấu hình tiêu chuẩn: Tốc độ 115200 bps &amp;bull; T_bit ≈ 8.68 µs &amp;bull; Khung truyền 10 bit (8-N-1): 1 Start + 8 Data + 1 Stop &amp;bull; T_frame ≈ 86.8 µs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#475569;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="140" y="980" width="2260" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lab1_softap_webserver" name="6. SoftAP Web Server Architecture">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="320" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="cont_softap" value="📡 EMBEDDED HTTP WEB SERVER TRÊN OBC (WI-FI SOFTAP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF5FD;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=15;fontColor=#0F172A;spacingTop=10;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="940" height="280" as="geometry"/>
                </mxCell>                <mxCell id="b_ap" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#1E3A8A;&quot;&gt;1. Wi-Fi SoftAP&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;SSID: PTITCube-OBC&lt;br&gt;IP: 192.168.4.1&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="70" y="70" width="240" height="70" as="geometry"/>
                </mxCell>                <mxCell id="b_srv" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#78350F;&quot;&gt;2. WebServer (Port 80)&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;GET / (HTML Dashboard)&lt;br&gt;GET /api/telemetry (JSON)&lt;br&gt;POST /api/cmd (Lệnh điều khiển)&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="370" y="70" width="280" height="70" as="geometry"/>
                </mxCell>                <mxCell id="b_client" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#14532D;&quot;&gt;3. Web Browser (Client)&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;fetch() cập nhật dữ liệu viễn trắc trực tiếp&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1.5;fontColor=#14532D;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="710" y="70" width="240" height="70" as="geometry"/>
                </mxCell>                <mxCell id="b_multi" value="Vòng lặp loop(): server.handleClient() + millis() điều độ đa nhiệm không chặn (Non-blocking)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#581C87;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="70" y="180" width="880" height="40" as="geometry"/>
                </mxCell>                <mxCell id="e1" value="Port 80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#78350F;" parent="1" source="b_ap" target="b_srv" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        
                    </mxGeometry>
                </mxCell>                <mxCell id="e2" value="Wi-Fi 2.4 GHz" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;startArrow=block;endArrow=block;startFill=1;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" parent="1" source="b_client" target="b_ap" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
