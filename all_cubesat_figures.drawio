                    <mxGeometry x="600" y="55" width="210" height="260" as="geometry"/>
                </mxCell>                <mxCell id="m1" value="1. Lấy Khóa Mutex" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" parent="1" edge="1">
