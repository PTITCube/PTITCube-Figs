                    <mxGeometry x="660" y="60" width="240" height="60" as="geometry"/>
                </mxCell>                <mxCell id="b_gauge" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#1E3A8A;&quot;&gt;📊 IC MAX17048 (I2C)&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;Đo điện áp VCELL &amp; % SOC&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="660" y="160" width="240" height="55" as="geometry"/>
                </mxCell>                <mxCell id="b_safety" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#991B1B;&quot;&gt;🛡️ Khóa An toàn (Safety Inhibits)&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;Chốt RBF Pin + 2 Công tắc hành trình tách ly&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;fontColor=#991B1B;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="260" y="160" width="340" height="55" as="geometry"/>
                </mxCell>                <mxCell id="b_buck" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#14532D;&quot;&gt;Hạ áp Buck 3.3V&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;Cấp nguồn OBC, Cảm biến, COM&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1.5;fontColor=#14532D;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="140" y="260" width="280" height="55" as="geometry"/>
