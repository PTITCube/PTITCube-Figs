                    <mxGeometry x="40" y="20" width="940" height="360" as="geometry"/>
                </mxCell>                <mxCell id="b_solar" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#78350F;&quot;&gt;☀️ Pin Mặt Trời&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;Mảng tế bào Solar quang điện&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="70" y="60" width="230" height="60" as="geometry"/>
                </mxCell>                <mxCell id="b_tp" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#991B1B;&quot;&gt;🔌 Mạch Sạc TP4056&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;Thuật toán nạp CC/CV (1A, 4.2V)&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;fontColor=#991B1B;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
