  <diagram id="lab3_priority_inversion_mutex" name="2. Priority Inversion &amp; Mutex">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="340" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
