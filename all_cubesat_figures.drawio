                    <mxGeometry relative="1" as="geometry">
                        
                    </mxGeometry>
                </mxCell>                <mxCell id="e2" value="Tín hiệu viễn trắc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#14532D;" parent="1" source="b_space" target="b_rx" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        
                    </mxGeometry>
                </mxCell>                <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" parent="1" source="b_rx" target="b_res" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        
