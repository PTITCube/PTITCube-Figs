                    <mxGeometry x="480" y="55" width="25" height="25" as="geometry"/>
                </mxCell>                <mxCell id="st_init" value="Khởi tạo WDT&lt;br&gt;(Timeout = 5s)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontStyle=1;fontFamily=Helvetica;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="400" y="100" width="180" height="45" as="geometry"/>
                </mxCell>                <mxCell id="st_run" value="Đang chạy bình thường&lt;br&gt;(Đếm lùi 5s ➔ 0s)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontStyle=1;fontFamily=Helvetica;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="380" y="180" width="220" height="50" as="geometry"/>
                </mxCell>                <mxCell id="st_feed" value="Nuôi chó (Feed WDT)&lt;br&gt;Nạp lại 5s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1.5;fontColor=#14532D;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="180" width="180" height="50" as="geometry"/>
                </mxCell>                <mxCell id="st_to" value="Timeout! (0s)&lt;br&gt;FSW bị treo / Deadlock" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;fontColor=#991B1B;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="700" y="180" width="200" height="50" as="geometry"/>
                </mxCell>                <mxCell id="st_rst" value="Kích hoạt Phần cứng Reset&lt;br&gt;Khởi động lại về Safe Mode" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="690" y="270" width="220" height="50" as="geometry"/>
                </mxCell>                <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" parent="1" source="wdt_start" target="st_init" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        
                    </mxGeometry>
                </mxCell>                <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" parent="1" source="st_init" target="st_run" edge="1">
