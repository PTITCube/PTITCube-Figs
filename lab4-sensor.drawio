                <mxCell id="cf_title" value="&lt;div style=&quot;font-size:15px;font-weight:bold;color:#0F172A;&quot;&gt;THUẬT TOÁN BỘ LỌC BÙ (COMPLEMENTARY FILTER) ƯỚC LƯỢNG TƯ THẾ&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="15" width="880" height="30" as="geometry"/>
                </mxCell>                <mxCell id="b_gyro" value="&lt;div style=&quot;font-weight:bold;color:#1E3A8A;&quot;&gt;Gyroscope (Con quay)&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;Vận tốc góc ω (deg/s)&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="50" y="65" width="210" height="55" as="geometry"/>
                </mxCell>                <mxCell id="b_int" value="Tích phân: ∫ω dt" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="310" y="65" width="160" height="55" as="geometry"/>
                </mxCell>                <mxCell id="b_hp" value="High-pass Filter&lt;br&gt;&lt;b&gt;× 0.98&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#581C87;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="520" y="65" width="150" height="55" as="geometry"/>
                </mxCell>                <mxCell id="b_accel" value="&lt;div style=&quot;font-weight:bold;color:#14532D;&quot;&gt;Accelerometer (Gia tốc)&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;Gia tốc trọng trường g&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1.5;fontColor=#14532D;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="50" y="160" width="210" height="55" as="geometry"/>
                </mxCell>                <mxCell id="b_trig" value="atan2(ax, az)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1.5;fontColor=#14532D;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="310" y="160" width="160" height="55" as="geometry"/>
                </mxCell>                <mxCell id="b_lp" value="Low-pass Filter&lt;br&gt;&lt;b&gt;× 0.02&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#581C87;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="520" y="160" width="150" height="55" as="geometry"/>
                </mxCell>                <mxCell id="b_sum" value="&lt;div style=&quot;font-size:22px;font-weight:bold;color:#0F172A;&quot;&gt;+&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;align=center;" parent="1" vertex="1">
                    <mxGeometry x="740" y="115" width="50" height="50" as="geometry"/>
                </mxCell>                <mxCell id="b_out" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#0F172A;&quot;&gt;Góc Tư thế (Roll / Pitch)&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#2563EB;&quot;&gt;&lt;b&gt;θ = 0.98·(θ_prev + ω·dt) + 0.02·θ_accel&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF5FD;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=15;fontColor=#0F172A;spacingTop=10;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="260" y="240" width="480" height="55" as="geometry"/>
                </mxCell>                <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;fontColor=#1E293B;" parent="1" source="b_gyro" target="b_int" edge="1">
