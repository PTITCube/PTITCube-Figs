                <mxCell id="rf_title" value="&lt;div style=&quot;font-size:15px;font-weight:bold;color:#0F172A;&quot;&gt;MÔ HÌNH NGÂN SÁCH ĐƯỜNG TRUYỀN VÔ TUYẾN (RF LINK BUDGET) CUBESAT LEO&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="50" y="15" width="950" height="30" as="geometry"/>
                </mxCell>                <mxCell id="b_tx" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#1E3A8A;&quot;&gt;1. Máy Phát Vệ tinh&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;P_tx = +20 dBm (100mW)&lt;br&gt;Anten G_tx = +2 dBi&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
