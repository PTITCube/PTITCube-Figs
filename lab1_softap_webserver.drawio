                    <mxGeometry x="40" y="20" width="940" height="280" as="geometry"/>
                </mxCell>                <mxCell id="b_ap" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#1E3A8A;&quot;&gt;1. Wi-Fi SoftAP&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;SSID: PTITCube-OBC&lt;br&gt;IP: 192.168.4.1&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="70" y="70" width="240" height="70" as="geometry"/>
                </mxCell>                <mxCell id="b_srv" value="&lt;div style=&quot;font-weight:bold;font-size:13px;color:#78350F;&quot;&gt;2. WebServer (Port 80)&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;GET / (HTML Dashboard)&lt;br&gt;GET /api/telemetry (JSON)&lt;br&gt;POST /api/cmd (Lệnh điều khiển)&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontFamily=Helvetica;fontSize=12;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="370" y="70" width="280" height="70" as="geometry"/>
